+     "@typescript-eslint/no-explicit-any": "off",
+     "jsx-a11y/role-supports-aria-props": "off",
+     "@next/next/no-img-element": "off"  // au cas où
+   }
+
+2. OR even simpler: completely disable ESLint during build by adding to next.config.mjs:
