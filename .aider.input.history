# 2025-11-20 22:44:32.705486
+Deploy MoodPal on Factory NOW – use pure HTML + vanilla JS single file, NO Next.js, NO TypeScript, NO ESLint
+
+Delete everything and replace with this exact single index.html (copy-paste the full code below).
+
+It already includes:
+• Full chibi canvas with mood parsing (amoureux → hearts, chaos → swirls, triste → tears, etc.)
+• Random variations + eye-blink animation
+• Daily streak + badges (crown day 3, wings day 7, halo day 30)
+• Mini calendar
+• Multilingual auto (FR/EN/ES/…)
+• Download PNG (transparent)
+• Cast on Farcaster + Gift simu
+• Zero dependencies, works offline
+
+Just deploy this one file and nothing else.
+
+```html
+<!DOCTYPE html>
+<html lang="fr">
+<head>
+<meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
+<title>MoodPal • Ton chibi du jour</title>
+<style>
+  body{margin:0;font-family:system-ui;background:#faf8ff;text-align:center;padding:20px}
+  h1{color:#a855f7;margin:20px}
+  input{width:90%;max-width:400px;padding:14px;font-size:18px;border-radius:12px;border:2px solid #e0e0e0;margin:15px 0}
+  button{padding:16px 32px;font-size:18px;background:linear-gradient(135deg,#a855f7,#3b82f6);color:#fff;border:none;border-radius:50px;cursor:pointer;margin:10px}
+  canvas{background:transparent;margin:20px auto;display:block;border-radius:20px;box-shadow:0 10px 30px rgba(0,0,0,.1)}
+  .buttons a{color:#a855f7;text-decoration:none;font-weight:bold;display:block;margin:12px}
+  .streak{font-size:22px;margin:15px}
+  .calendar{font-size:28px;letter-spacing:8px;margin:20px}
+</style>
+</head>
+<body>
+<h1>MoodPal</h1>
+<p>Comment te sens-tu aujourd’hui ?</p>
+<input id="mood" placeholder="ex: amoureux, chaos, triste, feu…" autofocus>
+<br><button onclick="generate()">Appelle MoodPal</button>
+<canvas id="chibi" width="350" height="400"></canvas>
+<div class="buttons" id="actions" style="display:none">
+  <button onclick="download()">Télécharger PNG</button><br>
+  <a href="#" onclick="cast()">Caster sur Farcaster</a>
+  <a href="#" onclick="gift()">Offrir un MoodPal</a>
+</div>
+<div class="streak" id="streak">Jour 1</div>
+<div class="calendar" id="calendar"></div>
+
+<script>
+const canvas=document.getElementById('chibi'),ctx=canvas.getContext('2d');
+const input=document.getElementById('mood'),actions=document.getElementById('actions');
+const streakEl=document.getElementById('streak'),calendarEl=document.getElementById('calendar');
+
+function updateStreak(){let s=parseInt(localStorage.getItem('moodpal_streak')||'0'),last=localStorage.getItem('moodpal_last'),today=new Date().toDateString();
+if(last!==today){if(last&&Date.parse(today)-Date.parse(last)>1728e5)s=0;s++;localStorage.setItem('moodpal_streak',s);localStorage.setItem('moodpal_last',today)}
+streakEl.textContent=`Jour ${s} 🔥`+(s>=30?" Eternal Pal":s>=7?" Légende":s>=3?" Champion":"");
+let cal="";for(let i=29;i>=0;i--){let d=new Date();d.setDate(d.getDate()-i);cal+=localStorage.getItem('moodpal_'+d.toDateString')?"🟢":"⚪"}calendarEl.textContent=cal}
+
+function drawChibi(m=""){m=m.toLowerCase();ctx.clearRect(0,0,350,400);
+let seed=m.split('').reduce((a,c)=>a+c.charCodeAt(0),0)+Date.now(),rnd=(s=1)=>(Math.sin(seed++)*10000%1)*s;
+let skin="#FFDAB9",hair=["#4B2E1A","#000","#FF6B6B","#FFB6C1","#8B4513"][Math.floor(rnd(5))],eye="#000",blush=false,acc="";
+if(m.includes("amour")||m.includes("love")){eye="#FF1493";blush=true;acc="heart"}
+if(m.includes("chaos")){hair="#FFAA00";eye="#FFFF00";acc="swirl"}
+if(m.includes("triste")||m.includes("sad")){eye="#4169E1";acc="tear"}
+if(m.includes("feu")||m.includes("angry")){eye="#FF4500";acc="fire"}
+ctx.fillStyle=skin;ctx.beginPath();ctx.arc(175,140,90,0,Math.PI*2);ctx.fill();
+ctx.fillStyle=hair;ctx.beginPath();ctx.moveTo(85,100);for(let i=0;i<5;i++)ctx.lineTo(85+rnd(180),60+rnd(60));ctx.closePath();ctx.fill();
+ctx.fillStyle="#fff";ctx.beginPath();ctx.arc(135,130,30,0,Math.PI*2);ctx.fill();ctx.beginPath();ctx.arc(215,130,30,0,Math.PI*2);ctx.fill();
+ctx.fillStyle=eye;let ps=15+rnd(10);ctx.beginPath();ctx.arc(135,130,ps,0,Math.PI*2);ctx.fill();ctx.beginPath();ctx.arc(215,130,ps,0,Math.PI*2);ctx.fill();
+if(acc==="heart"){ctx.fillStyle="#FF69B4";ctx.beginPath();ctx.moveTo(135,125);ctx.arc(125,125,10,0,Math.PI);ctx.arc(145,125,10,0,Math.PI);ctx.fill();ctx.beginPath();ctx.moveTo(215,125);ctx.arc(205,125,10,0,Math.PI);ctx.arc(225,125,10,0,Math.PI);ctx.fill()}
+if(blush){ctx.fillStyle="rgba(255,100,150,0.4)";ctx.beginPath();ctx.arc(110,160,25,0,Math.PI*2);ctx.fill();ctx.beginPath();ctx.arc(240,160,25,0,Math.PI*2);ctx.fill()}
+ctx.strokeStyle="#000";ctx.lineWidth=4;ctx.beginPath();ctx.arc(175,180,35,0.2,Math.PI-0.2);ctx.stroke();
+ctx.fillStyle="#A0C4FF";ctx.fillRect(125,220,100,120);
+let s=parseInt(localStorage.getItem('moodpal_streak')||0);
+if(s>=30){ctx.fillStyle="#FFD700";ctx.fillRect(145,40,60,30);ctx.fillStyle="#000";ctx.font="20px serif";ctx.fillText("⭐",160,63)}
+else if(s>=7){ctx.fillStyle="#87CEEB";ctx.beginPath();ctx.arc(175,70,40,0,Math.PI*2);ctx.fill()}
+else if(s>=3){ctx.fillStyle="#FFD700";ctx.beginPath();ctx.moveTo(175,50);ctx.lineTo(155,90);ctx.lineTo(195,90);ctx.closePath();ctx.fill()}
+clearInterval(window.blink);window.blink=setInterval(()=>{ctx.fillStyle=skin;ctx.fillRect(105,120,60,20);ctx.fillRect(185,120,60,20);setTimeout(()=>drawChibi(input.value),150)},3000+rnd(2000));
+actions.style.display="block";updateStreak()}
+
+function generate(){let m=input.value||"amoureux";localStorage.setItem('moodpal_'+new Date().toDateString(),m);drawChibi(m)}
+function download(){let a=document.createElement('a');a.download=`MoodPal_${new Date().toISOString().slice(0,10)}.png`;a.href=canvas.toDataURL();a.click()}
+function cast(){let s=localStorage.getItem('moodpal_streak')||1;alert(`Jour ${s} – Feeling ${input.value||"zen"} #MoodPal`)}
+function gift(){let addr=prompt("Adresse wallet ?");if(addr)alert("MoodPal envoyé à "+addr+" !")}
+
+input.addEventListener("keypress",e=>{if(e.key==="Enter")generate()});
+updateStreak();drawChibi("amoureux");
+</script>
+</body>
+</html>

